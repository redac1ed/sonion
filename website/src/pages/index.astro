---
const releases = "https://github.com/redac1ed/sonion/releases/latest/download";

const browsers = [
    {os: "windows", name: "Windows", detail: "64-bit", file: "sonion-browser-x86_64-pc-windows-msvc.zip"},
    {os: "mac", name: "macOS", detail: "Apple Silicon", file: "sonion-browser-aarch64-apple-darwin.zip", tag: "(Experimental)"},
    {os: "mac", name: "macOS", detail: "Intel", file: "sonion-browser-x86_64-apple-darwin.zip", tag: "(Experimental)"},
    {os: "linux", name: "Linux", detail: "64-bit", file: "sonion-browser-x86_64-unknown-linux-gnu.tar.gz", tag: "(Experimental)"}
];

const installers = [
    {label: "Linux and macOS", command: "curl -fsSL https://raw.githubusercontent.com/redac1ed/sonion/main/install.sh | sh"},
    {label: "Windows", command: "irm https://raw.githubusercontent.com/redac1ed/sonion/main/install.ps1 | iex"}
];
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Download sonion</title>
        <meta name="description" content="Download the sonion browser and CLI.">
        <link rel="icon" href="/favicon.svg" type="image/svg+xml">
        <style>
            :root {
                color-scheme: dark;
            }

            * {
                box-sizing: border-box;
            }

            body {
                min-height: 100vh;
                margin: 0;
                background: radial-gradient(ellipse 70% 420px at 50% 120px, #141414 0%, #000 100%);
                color: #a3a3a3;
                font: 15px/1.6 "Segoe UI", system-ui, sans-serif;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            header {
                display: flex;
                justify-content: flex-end;
                gap: 20px;
                max-width: 680px;
                margin: 0 auto;
                padding: 24px 16px;
            }

            header a:hover {
                color: #fff;
            }

            main {
                max-width: 680px;
                margin: 0 auto;
                padding: 32px 16px 64px;
            }

            .hero {
                display: flex;
                flex-direction: column;
                align-items: center;
                text-align: center;
            }

            .logo {
                width: 56px;
                height: 56px;
                margin-bottom: 16px;
                color: #fff;
            }

            h1 {
                margin: 0 0 8px;
                color: #fff;
                font-size: 32px;
                font-weight: 600;
                letter-spacing: -0.8px;
            }

            .hero p {
                max-width: 460px;
                margin: 0;
            }

            h2 {
                margin: 48px 0 12px;
                color: #fff;
                font-size: 15px;
                font-weight: 600;
            }

            .download {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-top: 8px;
                padding: 14px 18px;
                background: #0a0a0a;
                border: 1px solid #262626;
                border-radius: 12px;
                transition: background 0.15s, border-color 0.15s;
            }

            .download:hover {
                background: #141414;
                border-color: #525252;
            }

            .download.mine {
                background: #fff;
                border-color: #fff;
                color: #404040;
            }

            .download.mine strong {
                color: #000;
            }

            .download strong {
                color: #fff;
                font-weight: 600;
            }

            .tag {
                font-size: 12px;
            }

            .arrow {
                width: 18px;
                height: 18px;
                margin-left: auto;
                flex: none;
            }

            .note {
                margin: 12px 0 0;
                font-size: 13px;
            }

            .command {
                margin-top: 16px;
            }

            .command label {
                display: block;
                margin-bottom: 6px;
                font-size: 13px;
            }

            .command div {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 8px 8px 14px;
                background: #0a0a0a;
                border: 1px solid #262626;
                border-radius: 12px;
            }

            code {
                flex: 1;
                min-width: 0;
                overflow-x: auto;
                color: #e5e5e5;
                font: 13px ui-monospace, Consolas, monospace;
                white-space: nowrap;
                scrollbar-width: none;
            }

            button {
                flex: none;
                height: 32px;
                padding: 0 12px;
                background: #141414;
                border: 1px solid #262626;
                border-radius: 8px;
                color: #fff;
                font: inherit;
                font-size: 13px;
                cursor: pointer;
            }

            button:hover {
                border-color: #525252;
            }

            .links a {
                color: #fff;
                text-decoration: underline;
                text-underline-offset: 3px;
            }
        </style>
    </head>
    <body>
        <header>
            <a href="/docs/">Docs</a>
            <a href="https://github.com/redac1ed/sonion">GitHub</a>
        </header>
        <main>
            <section class="hero">
                <svg class="logo" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="24" cy="24" r="21"/>
                    <circle cx="24" cy="24" r="14" opacity="0.6"/>
                    <circle cx="24" cy="24" r="7" opacity="0.35"/>
                </svg>
                <h1>sonion.</h1>
                <p>A recreation of the World Wide Web.</p>
            </section>

            <h2>Browser</h2>
            {browsers.map((b) => (
                <a class="download" data-os={b.os} href={`${releases}/${b.file}`}>
                    <strong>{b.name}</strong>
                    <span>{b.detail}</span>
                    {b.tag && <span class="tag">{b.tag}</span>}
                    <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 4v12M7 11l5 5 5-5M5 20h14"/>
                    </svg>
                </a>
            ))}
            <p class="note">Unzip it and open the app. Your computer may warn you since the app isn't signed by a paid certificate. <br> <br> Linux also needs WebKitGTK: <span class="links"><a href="/docs/install/">see the install guide</a></span>.</p>

            <h2>Command line</h2>
            
            {installers.map((i) => (
                <div class="command">
                    <label>{i.label}</label>
                    <div>
                        <code>{i.command}</code>
                        <button type="button" data-copy={i.command}>Copy</button>
                    </div>
                </div>
            ))}
            <p class="note">Note: This is only for hosting sites and registering domains (through the CLI way, learn more in the documentation).</p>
            <p class="note links"><a href="https://github.com/redac1ed/sonion/releases/latest">All release files</a></p>
        </main>
        <script is:inline>
            const platform = navigator.userAgent;
            const os = /Windows/.test(platform) ? "windows" : /Mac/.test(platform) ? "mac" : /Linux/.test(platform) && !/Android/.test(platform) ? "linux" : null;
            if (os) {
                document.querySelectorAll(`.download[data-os="${os}"]`).forEach((link) => link.classList.add("mine"));
            }
            document.querySelectorAll("[data-copy]").forEach((button) => {
                button.addEventListener("click", async () => {
                    try {
                        await navigator.clipboard.writeText(button.dataset.copy);
                        button.textContent = "Copied";
                    } catch (_) {
                        button.textContent = "Select it";
                    }
                    setTimeout(() => {
                        button.textContent = "Copy";
                    }, 1500);
                });
            });
        </script>
    </body>
</html>
